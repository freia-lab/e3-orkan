#- ###         MODBUS   sauer   iocsh               ###
#- ####################################################
#- >> Mandatory
#- ASYN_PORT_NAME1 - MODBUS ASYN <name>
#- IP_ADDR1	  - ethernet address
#- PREFIX1	  - PV PREFIX
#- DEV_NAME1	  - Device name
#- ASYN_PORT_NAME2 - MODBUS ASYN <name>
#- IP_ADDR2	  - ethernet address
#- PREFIX2	  - PV PREFIX
#- DEV_NAME2	  - Device name
#- IOCNAME	  - Prefix for the asynRec and autosave
#- TOP		  - top directory for autosave
#-
#- >> Optional
#- IP_PORT	  - IP port number, default 502

epicsEnvSet("IOCDIR", "orkan")

iocshLoad("$(orkan_DIR)compressor-tcp.iocsh", "ASYN_PORT_NAME=$(ASYN_PORT_NAME1),IP_ADDR=$(IP_ADDR1),PREFIX=$(PREFIX1),DEV_NAME=$(DEV_NAME1)")
iocshLoad("$(orkan_DIR)compressor-tcp.iocsh", "ASYN_PORT_NAME=$(ASYN_PORT_NAME2),IP_ADDR=$(IP_ADDR2),PREFIX=$(PREFIX2),DEV_NAME=$(DEV_NAME2)")

dbLoadRecords("asynRecord.db","P=$(IOCNAME),R=:asynRec,PORT='$(ASYN_PORT_NAME1)',ADDR='0',IMAX='1024',OMAX='256'")

#################################################

# iocshLoad("$(autosave_DIR)autosave.iocsh", "AS_TOP=$(TOP),IOCNAME=$(IOCNAME)")

#################################################

asynSetTraceIOMask "$(ASYN_PORT_NAME1)",0,4   # Enable traceIOHex
#asynSetTraceMask "$(ASYN_PORT_NAME1)",0,9     # Enable traceError and traceIODriver
asynSetTraceIOMask "$(ASYN_PORT_NAME2)",0,4   # Enable traceIOHex
#asynSetTraceMask "$(ASYN_PORT_NAME2)",0,9     # Enable traceError and traceIODriver
